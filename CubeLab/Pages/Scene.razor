@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Cube Lab</PageTitle>

<div class="scene-host"
     @ref="_host"
     aria-label="Трёхмерная сцена с кубом">
</div>

@code {
    private ElementReference _host;

    private IJSObjectReference? _module;
    private IJSObjectReference? _scene;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/cube-scene.js");

        _scene = await _module.InvokeAsync<IJSObjectReference>(
            "createScene",
            _host);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_scene is not null)
            {
                await _scene.InvokeVoidAsync("dispose");
                await _scene.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The browser connection may already be closed.
        }
    }
}